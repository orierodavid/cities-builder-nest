# Public Supabase project settings. The publishable/anon key is public by design;
# database access must be protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed API, e.g. https://api.example.com
EXPO_PUBLIC_API_URL=http://localhost:4000

# Never place a service-role key, database password, or provider secret here.
