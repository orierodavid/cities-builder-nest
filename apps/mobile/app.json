{
  "expo": {
    "name": "CB Nest",
    "slug": "cb-nest",
    "scheme": "cbnest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/cb-nest-logo.png",
      "imageWidth": 132,
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CB Nest security personnel to scan visitor QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/cb-nest-logo.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citiesbuilder.nest",
      "icon": "./assets/cb-nest-logo.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.citiesbuilder.nest",
      "adaptiveIcon": {
        "foregroundImage": "./assets/cb-nest-logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "icon": "./assets/cb-nest-logo.png",
    "extra": {
      "router": {}
    }
  }
}
