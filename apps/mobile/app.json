{
  "expo": {
    "name": "Cities Builder Nest",
    "slug": "cities-builder-nest",
    "scheme": "citiesbuildernest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CB Nest security personnel to scan visitor access QR codes.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citiesbuilder.nest"
    },
    "android": {
      "package": "com.citiesbuilder.nest"
    }
  }
}
