{
  "expo": {
    "name": "Cities Builder Nest",
    "slug": "cities-builder-nest",
    "scheme": "citiesbuildernest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#050505",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CB Nest security personnel to scan visitor QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citiesbuilder.nest",
      "icon": "../web/public/IMG_9873.png"
    },
    "android": {
      "package": "com.citiesbuilder.nest",
      "adaptiveIcon": {
        "foregroundImage": "../web/public/IMG_9873.png",
        "backgroundColor": "#050505"
      }
    },
    "icon": "../web/public/IMG_9873.png"
  }
}
