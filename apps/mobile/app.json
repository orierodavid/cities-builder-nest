{
  "expo": {
    "name": "CB Nest",
    "slug": "cb-nest",
    "scheme": "cbnest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/cb-nest-logo.png",
      "imageWidth": 112,
      "backgroundColor": "#050505",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CB Nest security personnel to scan visitor QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citiesbuilder.nest",
      "icon": "./assets/cb-nest-logo.png"
    },
    "android": {
      "package": "com.citiesbuilder.nest",
      "adaptiveIcon": {
        "foregroundImage": "./assets/cb-nest-logo.png",
        "backgroundColor": "#050505"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "icon": "./assets/cb-nest-logo.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cff1ab38-ecdc-40e8-bdc7-3bcaded37a32"
      }
    }
  }
}
