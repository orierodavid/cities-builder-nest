# Common API settings
PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/database
NODE_ENV=development

# Optional Supabase settings (leave empty when using Railway only)
# Find these values in your Supabase project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER put this key in the mobile app or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: set to true only after Supabase Auth token verification is implemented and tested.
AUTH_PROVIDER=local
