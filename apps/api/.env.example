# API settings
PORT=4000
NODE_ENV=development
# Comma-separated exact browser origins; leave empty to deny browser-origin requests.
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://user:password@host:5432/database

# Required for API bearer-token validation. Use the project URL and publishable/anon key.
SUPABASE_URL=https://ldnxotehzkrrtovelmiz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_1M9SZpfH-SKR-DH7nhPiZA_L5kvHDIU

# Server-only secrets: never expose these in the mobile app or commit real values.
# Required to create invited users through Supabase Auth Admin API.
SUPABASE_SERVICE_ROLE_KEY=
# Optional deep link / web URL used by the Supabase invitation email redirect.
AUTH_INVITE_REDIRECT_URL=
AUTH_PROVIDER=supabase
