# API settings
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/database

# Required for API bearer-token validation. Use the project URL and publishable/anon key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secrets: do not use in mobile apps or commit real values.
# SUPABASE_SERVICE_ROLE_KEY is intentionally not required for the auth endpoints.
AUTH_PROVIDER=supabase
