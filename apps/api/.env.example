# API settings
PORT=4000
# Default: use the PostgreSQL connection string from your Supabase project.
DATABASE_URL=postgresql://user:password@host:5432/database
NODE_ENV=development

# Supabase project settings (used when implementing Supabase Auth/client integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER put this key in the mobile app or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Keep local until Supabase Auth token verification is implemented and tested.
AUTH_PROVIDER=local
