# API settings
PORT=4000
NODE_ENV=development
# Local development runs directly without a trusted reverse proxy.
# Set this to the exact proxy-hop count only when deploying behind a trusted ingress.
TRUST_PROXY_HOPS=0
# Comma-separated exact browser origins; leave empty to deny browser-origin requests.
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://user:password@host:5432/database
# Keep false until the connection role can SET ROLE authenticated and RLS has been verified.
# The first native PostgreSQL route is GET /v1/me; Supabase PostgREST remains the default.
NATIVE_POSTGRES_READS=false

# Shared Redis instance required for production API rate limiting.
# Use a private Redis endpoint and TLS (rediss://) when required by the provider.
REDIS_URL=redis://localhost:6379

# Required for API bearer-token validation. Use the project URL and publishable/anon key.
SUPABASE_URL=https://ldnxotehzkrrtovelmiz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_1M9SZpfH-SKR-DH7nhPiZA_L5kvHDIU

# Server-only secrets: never expose these in the mobile app or commit real values.
# Required to create invited users through Supabase Auth Admin API.
SUPABASE_SERVICE_ROLE_KEY=
# Optional deep link / web URL used by the Supabase invitation email redirect.
AUTH_INVITE_REDIRECT_URL=
AUTH_PROVIDER=supabase
