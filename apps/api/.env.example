SUPABASE_ANON_KEY=sb_publishable_1M9SZpfH-SKR-DH7nhPiZA_L5kvHDIU

# Server-only secrets: do not use in mobile apps or commit real values.
# SUPABASE_SERVICE_ROLE_KEY is intentionally not required for the auth endpoints.
AUTH_PROVIDER=supabase
